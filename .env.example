# ============================================
# AutoBlog Engine — Configuration
# ============================================
# Copy this file to .env and fill in your values

# --- Site ---
SITE_NAME="AI & Tech Simplified"
SITE_URL="https://your-site.pages.dev"
SITE_DESCRIPTION="Latest AI tools, tech tutorials, and simplified guides in English and Hindi"

# --- Ollama (Local LLM) ---
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:14b"
# Smaller model for quick tasks (keyword research, summaries)
OLLAMA_MODEL_FAST="qwen2.5:7b"

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Pexels API (Free stock photos) ---
# Get a free key at https://www.pexels.com/api/
PEXELS_API_KEY=""

#----unplash api key
UNSPLASH_API_KEY="https://api.unsplash.com/search/photos?query=mountains&client_id=U2dvwI-k3nNkFfSD9FqugIkxIsmYlL1HBBUkMvCuf-I"

# --- SearXNG (Self-hosted search) ---
SEARXNG_URL="http://localhost:8080"

# --- Paths ---
VAULT_PATH="d:/Jenish/Automation/vault"
WEBSITE_PATH="d:/Jenish/Automation/website"
DATABASE_PATH="d:/Jenish/Automation/pipeline/autoblog.db"

# --- Schedule (24h format) ---
SCHEDULE_RESEARCH="02:00"
SCHEDULE_KEYWORDS="03:00"
SCHEDULE_WRITING="04:00"
SCHEDULE_IMAGES="04:30"
SCHEDULE_PUBLISH_CHECK="*/30 * * * *"
SCHEDULE_HEALTH_CHECK="*/15 * * * *"
SCHEDULE_DAILY_SUMMARY="20:00"
SCHEDULE_WEEKLY_SUMMARY="SUN 20:00"

# --- Content ---
# Max posts to draft per day
MAX_DAILY_DRAFTS=3
# Languages to generate (comma-separated)
LANGUAGES="en,hi"
# Primary language (drafts written here first)
PRIMARY_LANGUAGE="en"

# --- Git (for auto-deploy) ---
GIT_REPO_URL=""
GIT_BRANCH="main"
GIT_AUTO_PUSH=true

# --- Monitoring ---
# Uptime check interval in seconds
HEALTH_CHECK_INTERVAL=900
# Max consecutive failures before alert
MAX_FAILURES_BEFORE_ALERT=3
# Auto-fix common issues (true/false)
AUTO_HEAL_ENABLED=true

# --- Image Generation (Local, optional) ---
# Set to true if you have ComfyUI installed
LOCAL_IMAGE_GEN=false
COMFYUI_URL="http://localhost:8188"

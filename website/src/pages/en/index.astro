---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => {
  return data.lang === 'en' && !data.draft;
});

const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
---

<BaseLayout
  title="Home"
  description="Latest AI tools, tech tutorials, and simplified guides. Stay updated with the world of technology."
  lang="en"
  alternateUrl="/hi/"
  alternateLang="hi"
>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <h1>AI & Tech Simplified</h1>
      <p class="hero-subtitle">
        Cutting-edge AI tools, hands-on tutorials, and tech insights — explained simply so you can build smarter.
      </p>
      <div class="hero-tags">
        {tags.slice(0, 6).map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Blog Grid -->
  <section class="container">
    {posts.length === 0 ? (
      <div style="text-align: center; padding: 4rem 0; color: var(--color-text-muted);">
        <p style="font-size: 1.25rem; margin-bottom: 1rem;">✨ First posts coming soon!</p>
        <p>The pipeline is warming up. Check back shortly.</p>
      </div>
    ) : (
      <div class="blog-grid">
        {posts.map((post, i) => (
          <article class={`blog-card animate-in`}>
            {post.data.heroImage && (
              <img
                class="blog-card-image"
                src={post.data.heroImage}
                alt={post.data.heroImageAlt || post.data.title}
                loading={i < 3 ? 'eager' : 'lazy'}
              />
            )}
            <div class="blog-card-body">
              <div class="blog-card-meta">
                <span class="blog-card-date">
                  📅 {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </span>
              </div>
              <h2 class="blog-card-title">
                <a href={`/en/${post.slug}/`}>{post.data.title}</a>
              </h2>
              <p class="blog-card-excerpt">{post.data.description}</p>
              <div class="blog-card-tags">
                {post.data.tags.slice(0, 3).map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</BaseLayout>

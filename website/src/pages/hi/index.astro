---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => {
  return data.lang === 'hi' && !data.draft;
});

const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPost = posts[0];
const remainingPosts = posts.slice(1);
const INITIAL_VISIBLE = 5;
---

<BaseLayout
  title="लेख और टिप्पणियाँ"
  description="सॉफ्टवेयर और आधुनिक कृत्रिम बुद्धिमत्ता पर गहन विश्लेषण, समीक्षाएं और तकनीकी लेख।"
  lang="hi"
  alternateUrl="/en/"
  alternateLang="en"
>
  <div class="page-container">
    <!-- Publication Masthead -->
    <section class="hero-editorial">
      <span class="masthead-kicker">तकनीक और AI का संपादकीय प्रकाशन</span>
      <h1 class="hero-editorial-title">लेख और टिप्पणियाँ</h1>
      <p class="hero-editorial-subtitle">
        तकनीक, आर्टिफिशियल इंटेलिजेंस और डिजिटल दुनिया पर स्वतंत्र विश्लेषण और विचार।
      </p>
      <div class="masthead-rule" aria-hidden="true"></div>
    </section>

    {posts.length === 0 ? (
      <div class="empty-state">
        <p>अभी कोई लेख प्रकाशित नहीं हुआ है। कृपया शीघ्र ही पुनः देखें।</p>
      </div>
    ) : (
      <>
        <!-- Featured Visual Anchor -->
        {featuredPost && (
          <article class="featured-post">
            <div class="featured-kicker-bar">
              <span class="badge-featured">विशेष संपादकीय</span>
              {featuredPost.data.tags?.[0] && (
                <>
                  <span class="meta-tag">{featuredPost.data.tags[0]}</span>
                  <span class="meta-separator" aria-hidden="true">·</span>
                </>
              )}
              <time datetime={featuredPost.data.pubDate.toISOString()} class="meta-date">
                {featuredPost.data.pubDate.toLocaleDateString('hi-IN', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </time>
            </div>

            {featuredPost.data.heroImage && (
              <div class="featured-hero-wrap">
                <a href={`/hi/${featuredPost.slug}/`}>
                  <img
                    src={featuredPost.data.heroImage}
                    alt={featuredPost.data.heroImageAlt || featuredPost.data.title}
                    class="featured-hero-image"
                    loading="eager"
                  />
                </a>
              </div>
            )}

            <h2 class="featured-title">
              <a href={`/hi/${featuredPost.slug}/`}>
                {featuredPost.data.title}
              </a>
            </h2>

            {featuredPost.data.description && (
              <p class="featured-description">
                {featuredPost.data.description}
              </p>
            )}

            <div>
              <a href={`/hi/${featuredPost.slug}/`} class="read-more-btn">
                <span>पूरा लेख पढ़ें</span>
                <svg class="read-more-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </a>
            </div>
          </article>
        )}

        <!-- Remaining Dispatches with Thumbnails -->
        {remainingPosts.length > 0 && (
          <section aria-label="हाल के लेख">
            <header class="section-header">
              <h2 class="section-title">हाल के आलेख</h2>
              <span class="section-count">{remainingPosts.length} लेख</span>
            </header>

            <ul class="posts-list">
              {remainingPosts.map((post, index) => (
                <li class="post-row" data-hidden={index >= INITIAL_VISIBLE ? 'true' : undefined}>
                  <div class="post-row-content">
                    <div class="post-meta" style="margin-bottom: 0.5rem;">
                      {post.data.tags && post.data.tags.length > 0 && (
                        <>
                          <span class="meta-tag">{post.data.tags[0]}</span>
                          <span class="meta-separator" aria-hidden="true">·</span>
                        </>
                      )}
                      <time datetime={post.data.pubDate.toISOString()} class="meta-date">
                        {post.data.pubDate.toLocaleDateString('hi-IN', {
                          year: 'numeric',
                          month: 'short',
                          day: 'numeric',
                        })}
                      </time>
                    </div>

                    <h3 class="post-title">
                      <a href={`/hi/${post.slug}/`}>{post.data.title}</a>
                    </h3>

                    {post.data.description && (
                      <p class="post-description">{post.data.description}</p>
                    )}

                    <a href={`/hi/${post.slug}/`} class="read-more-link">
                      <span>अधिक पढ़ें</span>
                      <svg class="read-more-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                      </svg>
                    </a>
                  </div>

                  {post.data.heroImage && (
                    <a href={`/hi/${post.slug}/`} class="post-thumbnail-link" tabindex="-1" aria-hidden="true">
                      <img
                        src={post.data.heroImage}
                        alt=""
                        class="post-thumbnail"
                        loading="lazy"
                      />
                    </a>
                  )}
                </li>
              ))}
            </ul>

            {remainingPosts.length > INITIAL_VISIBLE && (
              <div class="load-more-container" id="load-more-container">
                <button id="load-more-btn" class="btn-load-more" type="button">
                  <span>और लेख देखें</span>
                  <svg class="load-more-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                  </svg>
                </button>
                <span class="load-more-count" id="load-more-count">
                  <strong>{remainingPosts.length}</strong> में से <strong id="visible-count">{Math.min(INITIAL_VISIBLE, remainingPosts.length)}</strong> लेख दिखाए गए
                </span>
              </div>
            )}
          </section>
        )}
      </>
    )}
  </div>

  <script is:inline>
    (function() {
      const BATCH_SIZE = 5;
      const btn = document.getElementById('load-more-btn');
      const counter = document.getElementById('visible-count');
      const hiddenRows = Array.from(document.querySelectorAll('.post-row[data-hidden="true"]'));
      if (!btn || hiddenRows.length === 0) return;

      let revealedCount = 0;

      btn.addEventListener('click', function() {
        const nextBatch = hiddenRows.slice(revealedCount, revealedCount + BATCH_SIZE);
        nextBatch.forEach(function(row) {
          row.removeAttribute('data-hidden');
          row.classList.add('post-row-revealed');
        });
        revealedCount += nextBatch.length;

        if (counter) {
          counter.textContent = String(5 + revealedCount);
        }

        if (revealedCount >= hiddenRows.length) {
          btn.disabled = true;
          btn.classList.add('all-loaded');
          btn.innerHTML = '<span>सभी लेख लोड हो चुके हैं</span> ✓';
        }
      });
    })();
  </script>
</BaseLayout>
